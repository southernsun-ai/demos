# Copy to .env and fill in. `make` loads this file automatically.

# Option A: route through the Pydantic AI Gateway (recommended — same key as Macabeo).
PYDANTIC_AI_GATEWAY_API_KEY=
# GATEWAY_BASE_URL=https://gateway-us.pydantic.dev/proxy  # default; override if needed

# Option B: call Anthropic directly (leave blank when using the gateway above).
# ANTHROPIC_API_KEY=

# Defaults (optional). Aliases: haiku | sonnet | opus, or any provider:model string.
MOD_CHAT_MODEL=haiku
MOD_CHAT_EFFORT=medium

# Optional tracing: set to send agent and eval spans to Logfire (pip install logfire).
# LOGFIRE_TOKEN=
