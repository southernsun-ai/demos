# direnv configuration. Entirely optional.
#
# NEVER PUT SECRETS IN THIS FILE. It is committed to the repository.
# Secrets belong in .env, which is gitignored.
#
# If you use direnv (https://direnv.net), run `direnv allow` once and .env will
# be loaded automatically whenever you enter this directory.
#
# If you do not use direnv, ignore this file. `uv run fernpost` loads .env by
# itself via python-dotenv, so nothing here is required.

dotenv_if_exists .env
